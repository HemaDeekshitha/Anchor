# Public production URLs
FRONTEND_URL=https://anchorapp.feeltiptop.com
NEXT_PUBLIC_WEBSITE_URL=https://anchorapp.feeltiptop.com
# Required: public HTTPS URL that proxies to backend port 3012.
NEXT_PUBLIC_API_URL=https://your-api-domain.example.com
APP_URL=https://anchorapp.feeltiptop.com

# Database
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_SSL=true

# Authentication and Google OAuth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_GMAIL_CALLBACK_URL=

# Email delivery (configure Mailjet or SendGrid)
